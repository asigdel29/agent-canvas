{
  "name": "@agent-canvas/orchestrator",
  "version": "0.0.0",
  "private": true,
  "description": "Backend orchestrator: command endpoint, event log, projector, reconciler, vault, billing gate, input sanitizer.",
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "eval": "vitest run --config evals/vitest.config.ts",
    "migrate": "node --import tsx ./src/postgres/migrate-cli.ts",
    "dev": "npm run build && node --import tsx ./scripts/dev-server.ts"
  },
  "dependencies": {
    "@agent-canvas/connector-core": "*",
    "@agent-canvas/orchestrator-types": "*",
    "@e2b/desktop": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.60.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "AGPL-3.0-only"
}
