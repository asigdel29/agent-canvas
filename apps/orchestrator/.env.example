# agent-canvas/orchestrator — environment variables
#
# Copy to .env.local for local development. Set in Vercel project
# settings (or `vercel env add`) for staging/production.

# ─────────────────────────────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────────────────────────────
# Transaction-pooled connection string. Required for any non-trivial
# deployment. Without it, the orchestrator falls back to in-memory
# storage (cold-start loses everything).
DATABASE_URL=postgres://user:pass@host:5432/agent_canvas?sslmode=require

# Session-mode pool used by the LISTEN/NOTIFY sync layer. Same host as
# DATABASE_URL, different connection-string flavor on Neon.
DATABASE_URL_SESSION=postgres://user:pass@host:5432/agent_canvas?sslmode=require&options=-c%20pool_mode=session

# ─────────────────────────────────────────────────────────────────────
# KMS — long-lived credential encryption
# ─────────────────────────────────────────────────────────────────────
# AWS KMS key ID or alias. Absence falls back to StubKmsClient (NO
# encryption; suitable for local-only).
KMS_KEY_ID=alias/agent-canvas-prod
AWS_REGION=us-east-1
# AWS credentials follow the default chain (IAM role on Vercel, env
# vars locally). Set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY for
# local testing.

# ─────────────────────────────────────────────────────────────────────
# OAuth client credentials
# Wired: GitHub, Linear, Slack, Discord, Vercel, Supabase
# Stubbed (PAT-only providers, no public OAuth): Graphite, Railway
# ─────────────────────────────────────────────────────────────────────
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
# Graphite uses personal access tokens — store the PAT in the vault
# directly; no OAuth handover. Same for Railway (project tokens).

# ─────────────────────────────────────────────────────────────────────
# Webhook secrets — one per provider, looked up by the route handler
# ─────────────────────────────────────────────────────────────────────
WEBHOOK_SECRET_GITHUB=
WEBHOOK_SECRET_LINEAR=
WEBHOOK_SECRET_SLACK=
WEBHOOK_SECRET_DISCORD=             # for Discord, this is the application public key (hex)
WEBHOOK_SECRET_GRAPHITE=
WEBHOOK_SECRET_RAILWAY=
WEBHOOK_SECRET_VERCEL=
WEBHOOK_SECRET_SUPABASE=
WEBHOOK_SECRET_CODEX=
WEBHOOK_SECRET_OPENHANDS=

# ─────────────────────────────────────────────────────────────────────
# Session auth (HS256 JWT)
# ─────────────────────────────────────────────────────────────────────
# Rotate by replacing this value; all in-flight sessions invalidate.
JWT_SECRET=

# Separate secret for short-lived (60s) single-use SSE tokens. Distinct
# from JWT_SECRET so a leak of one does not compromise the other.
# Generate with: openssl rand -hex 32
SSE_TOKEN_SECRET=

# Separate secret for the OAuth state JWT minted during GitHub sign-in.
# Distinct from JWT_SECRET so a state-token leak cannot mint sessions.
# Generate with: openssl rand -hex 32
AUTH_STATE_SECRET=

# Origin where the canvas is served. Used to validate the OAuth
# redirect_to query parameter (open-redirect defence) and to send the
# user back after a successful sign-in.
CANVAS_ORIGIN=http://localhost:5173

# Public origin of the orchestrator. GitHub OAuth callbacks land here.
# Defaults to the request's host when unset (works locally but not
# behind a proxy where the public URL differs from the host header).
PUBLIC_ORCHESTRATOR_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────
# Agent runtime — Anthropic + E2B (computer-use)
# ─────────────────────────────────────────────────────────────────────
# Required to start any run. Without this, POST /api/agents/runs
# returns 503 anthropic_not_configured.
ANTHROPIC_API_KEY=

# Required only for agents whose computer_use capability is enabled
# AND provider is 'e2b'. Without this the run still starts (MCP and
# browser-use work) and a computer_use_unavailable event lands in
# the room bus so the canvas can show the operator why the computer
# tool is missing.
E2B_API_KEY=

# Display dimensions Anthropic's computer_20241022 tool is told the
# desktop has. Pixel coordinates in the model's tool_use payloads
# are interpreted against these. Defaults: 1024x768.
COMPUTER_USE_WIDTH=1024
COMPUTER_USE_HEIGHT=768

# ─────────────────────────────────────────────────────────────────────
# Upstash Redis (SSE nonce store)
# ─────────────────────────────────────────────────────────────────────
# Production deployments MUST set these. Without them the orchestrator
# falls back to a per-instance in-memory nonce cache that allows a
# capture-and-replay window equal to the SSE token TTL (60 s) when two
# concurrent requests with the same token land on different function
# instances. The orchestrator logs a WARN at startup if SSE_TOKEN_SECRET
# is set without these.
#
# Provision via https://console.upstash.com/redis (REST API enabled).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# CORS — explicit allowlist for the canvas origin(s)
# ─────────────────────────────────────────────────────────────────────
# Comma-separated. Wildcards ('*') are silently stripped. The literal
# 'null' is rejected (sandboxed iframes / file:// send Origin: null and
# must NEVER be honored). Trailing slashes are stripped automatically.
# http:// is allowed only for localhost / 127.0.0.1 (dev convenience);
# https:// is required for everything else.
#
# Leave empty for same-origin-only deployments.
ALLOWED_ORIGINS=
# Examples:
#   ALLOWED_ORIGINS=https://canvas.yourdomain.com
#   ALLOWED_ORIGINS=https://canvas.yourdomain.com,https://staging.canvas.yourdomain.com

# ─────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────
# JSON log level: debug | info | warn | error. Defaults to 'info'.
LOG_LEVEL=info

# Sentry DSN. When set, every logger.error() call also POSTs the
# event to Sentry. Empty = no-op (local dev never reports). We do
# NOT use the @sentry/node SDK — it autocaptures fetch, which would
# leak user-pasted API keys; see src/observability/errorReporter.ts.
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────
# Feature toggles
# ─────────────────────────────────────────────────────────────────────
BILLING_ENABLED=true                # turn on the budget gate
ENABLE_MOCK_PROVIDER=false          # register MockProvider (local-only)
DEFAULT_PROJECT_ID=proj_default
