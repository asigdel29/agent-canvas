{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"outputDirectory": "public",
	"functions": {
		"api/dispatch.ts": {
			"runtime": "@vercel/node@5.8.5",
			"maxDuration": 60
		}
	},
	"rewrites": [
		{ "source": "/api/(.*)", "destination": "/api/dispatch" }
	],
	"crons": [
		{
			"path": "/api/cron/drain-webhooks",
			"schedule": "0 0 * * *"
		}
	]
}
