{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "npm run build --workspace=@agent-canvas/orchestrator-types --workspace=@agent-canvas/connector-core --workspace=@agent-canvas/orchestrator",
	"installCommand": "npm install --workspaces --include-workspace-root",
	"framework": null,
	"functions": {
		"api/**/*.ts": {
			"runtime": "@vercel/node@5.0.0",
			"maxDuration": 60
		}
	}
}
