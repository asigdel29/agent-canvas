# Dev-only: the Vite dev server runs the canvas on :5173 while the
# orchestrator runs on :3000, so point API + SSE requests at :3000.
#
# The PRODUCTION build intentionally has no VITE_ORCHESTRATOR_URL — the
# canvas then talks to /api on whatever origin served it (same-origin,
# no CORS). See apps/canvas/src/config.ts.
VITE_ORCHESTRATOR_URL=http://localhost:3000
