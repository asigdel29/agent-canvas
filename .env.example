# agent-canvas — environment
#
# Copy to `.env` (./scripts/setup.sh does this and fills the secrets for
# you), then edit the few values below. On Railway, set these in the
# service's Variables tab instead of committing a file. Real environment
# variables always win over this file.
#
# Only the four secrets + DATABASE_URL are needed to boot. Everything
# else is optional and clearly marked.

# ─────────────────────────────────────────────────────────────────────
# Secrets (REQUIRED) — ./scripts/setup.sh fills these with random hex.
# Regenerate any time with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────
# Signs the session JWT. Rotating it invalidates all sessions.
JWT_SECRET=
# Signs short-lived (60s) single-use SSE tokens. Distinct from JWT_SECRET
# so leaking one does not compromise the other.
SSE_TOKEN_SECRET=
# Signs the OAuth state JWT during GitHub sign-in (github auth mode only).
AUTH_STATE_SECRET=
# 32-byte hex key (64 chars) for AES-256-GCM encryption of stored
# credentials at rest. Optional: without it the vault uses a no-encryption
# stub suitable only for local testing.
VAULT_KEY=

# ─────────────────────────────────────────────────────────────────────
# Database (REQUIRED for persistence)
# ─────────────────────────────────────────────────────────────────────
# Postgres connection string. On Railway, add a Postgres plugin and
# reference its variable: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Without it the orchestrator runs fully in-memory (everything is lost on
# restart) — fine for a quick local try, not for real collaboration.
DATABASE_URL=

# Optional session-mode pool for the LISTEN/NOTIFY multiplayer layer.
# Falls back to DATABASE_URL when unset, which is correct for a single
# instance (the normal self-host case).
DATABASE_URL_SESSION=

# ─────────────────────────────────────────────────────────────────────
# Auth mode
# ─────────────────────────────────────────────────────────────────────
# github (default) — require GitHub sign-in (set the two OAuth vars below).
# open            — trusted internal deploy: teammates join with just a
#                   display name, no external login, no OAuth app needed.
#                   Open mode disables per-workspace isolation, so only
#                   use it behind your own network boundary.
AUTH_MODE=github

# GitHub OAuth app (needed only when AUTH_MODE=github). Create one at
# https://github.com/settings/developers with the callback set to
# <your-origin>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# AI keys — BYOK (bring your own key)
# ─────────────────────────────────────────────────────────────────────
# Each user can paste their own Claude key in Settings (it stays in their
# browser and travels per-request). Set a key here only if you want a
# shared server-side fallback. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: only for agents using computer-use (E2B Desktop sandbox).
# Users can also paste this per-session in Settings. https://e2b.dev
E2B_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Server (optional)
# ─────────────────────────────────────────────────────────────────────
# Port the single-process server listens on. Railway injects this.
PORT=3000

# Extra CORS origins, comma-separated. Leave empty for the normal
# single-domain deploy (canvas + API on one origin = no CORS needed).
ALLOWED_ORIGINS=

# JSON log level: debug | info | warn | error. Default: info.
LOG_LEVEL=info

# GitHub inbound webhook signing secret (only if you wire GitHub webhooks).
WEBHOOK_SECRET_GITHUB=

# Register MockProvider for local smoke testing without real agents.
ENABLE_MOCK_PROVIDER=false
