{
  "name": "agent-canvas",
  "version": "0.0.1",
  "private": true,
  "description": "Multiplayer infinite-canvas platform for running cloud AI agents, built on tldraw.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "dev": "concurrently --kill-others-on-fail --names 'orch,canvas' --prefix-colors 'magenta,cyan' 'npm:dev:orchestrator' 'npm:dev:canvas'",
    "dev:orchestrator": "npm run dev --workspace=@agent-canvas/orchestrator",
    "dev:canvas": "npm run dev --workspace=@agent-canvas/canvas",
    "setup:env": "node ./scripts/setup-env.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
