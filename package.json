{
  "name": "agent-canvas",
  "version": "0.0.1",
  "private": true,
  "description": "Multiplayer infinite-canvas platform for running cloud AI agents, built on tldraw.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "dev": "concurrently --kill-others-on-fail --names 'orch,canvas' --prefix-colors 'magenta,cyan' 'npm:dev:orchestrator' 'npm:dev:canvas'",
    "dev:orchestrator": "npm run dev --workspace=@agent-canvas/orchestrator",
    "dev:canvas": "npm run dev --workspace=@agent-canvas/canvas",
    "start": "node --import tsx apps/orchestrator/scripts/server.ts",
    "migrate": "npm run migrate --workspace=@agent-canvas/orchestrator",
    "setup": "./scripts/setup.sh",
    "setup:env": "node ./scripts/setup-env.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "AGPL-3.0-only"
}
